# Copy to .env and adjust. `make` and docker compose both read it.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Used by `make run` and `make seed`. Inside docker compose the bot reaches
# Postgres over the compose network, so this value is not used there.
POSTGRES_DSN=postgres://shop:shop@localhost:5433/shop?sslmode=disable
POSTGRES_MAX_CONNS=10

# Used by `make run`; inside docker compose the bot uses the stack's Redis.
REDIS_ADDR=localhost:6380

# --- AI consultant -------------------------------------------------------------
# claude | none. With none the bot runs on buttons alone and needs no key.
LLM_PROVIDER=claude
# From https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# low | medium | high. Low is fast and cheap, and enough for a shop chat.
LLM_EFFORT=low

# Model calls per buyer message, and the deadline for the whole answer. The
# deadline must be shorter than BOT_HANDLER_TIMEOUT.
AGENT_MAX_STEPS=6
AGENT_TIMEOUT=45s
# Stored conversation: messages kept, and how long after the last one.
AGENT_HISTORY_MESSAGES=30
AGENT_HISTORY_TTL=24h
# Messages per user per window that go to the model (cost protection).
AGENT_RATE_LIMIT=30
AGENT_RATE_WINDOW=1h

# --- Payments (Monobank acquiring) ----------------------------------------------
# Test token: api.monobank.ua -> "Create test token". Empty turns checkout off.
MONOBANK_TOKEN=
MONOBANK_API_URL=https://api.monobank.ua
# Where Monobank can reach the webhook (https only), e.g. an ngrok or
# cloudflared tunnel to BOT_HTTP_ADDR. Empty: payments are found by polling
# the invoice status every PAYMENT_RECONCILE_EVERY instead.
PUBLIC_URL=
BOT_HTTP_ADDR=:8090
PAYMENT_RECONCILE_EVERY=30s
# Where managers get paid orders. Send /id to the bot from that chat to see it.
ADMIN_CHAT_ID=

# Updates accepted but not yet handled. When reached, the bot stops polling
# until handlers catch up.
BOT_MAX_PENDING=256
# Upper bound on handling one update.
BOT_HANDLER_TIMEOUT=60s

# Remind a buyer once about a cart left untouched this long; 0 turns it off.
# Reminders go out between 9:00 and 21:00 in BOT_TIMEZONE.
CART_REMINDER_AFTER=24h
CART_REMINDER_EVERY=10m
BOT_TIMEZONE=Europe/Kyiv

# Where buyers collect orders, with the hours. Empty: Nova Poshta only.
SHOP_PICKUP_ADDRESS="Київ, вул. Автозаводська 1, пн–сб 9:00–19:00"

# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text

# Auto-DB Pro parts catalogue: vehicles and what fits them. The account lets
# requests in from one IP address, set in its dashboard. Empty turns it off.
AUTODB_API_URL=https://auto-db.pro/api/v1/
AUTODB_USER=
AUTODB_PASSWORD=
# Requests per second to the API, all together, and the share crawls and
# enrichment may take, so a buyer's lookup never waits behind them.
AUTODB_RPS=4
AUTODB_BACKGROUND_RPS=2

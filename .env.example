# Copy to .env and adjust. `make` and docker compose both read it.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Used by `make run` and `make seed`. Inside docker compose the bot reaches
# Postgres over the compose network, so this value is not used there.
POSTGRES_DSN=postgres://shop:shop@localhost:5433/shop?sslmode=disable
POSTGRES_MAX_CONNS=10

# Updates accepted but not yet handled. When reached, the bot stops polling
# until handlers catch up.
BOT_MAX_PENDING=256
# Upper bound on handling one update.
BOT_HANDLER_TIMEOUT=20s

# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text

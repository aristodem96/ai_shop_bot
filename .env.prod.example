# Production settings. Copy to .env ON THE SERVER and fill in real values.
# Never commit the filled-in file: .gitignore already excludes .env.
#
# Generate each password with:  openssl rand -base64 32

# Makes every `docker compose` command in this directory use both files, so a
# plain `docker compose down` cannot read only the base file and leave half
# the stack running -- caddy is not in the base file, and the bot sits behind
# a profile there. Keep this first.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The domain that points at this server. Caddy requests a certificate for it,
# and Monobank posts payment webhooks to https://BOT_DOMAIN/webhooks/monobank.
BOT_DOMAIN=shop-bot.example.com

# Postgres credentials. Changing these after the first start does NOT change
# the existing database -- the volume keeps the old ones.
POSTGRES_USER=shop
POSTGRES_PASSWORD=
POSTGRES_DB=shop

REDIS_PASSWORD=

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# From https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=

# The merchant token from web.monobank.ua (Integrations -> To my website).
# A test token from api.monobank.ua works too, and moves no real money --
# but it is a personal token, so keep it off shared servers.
MONOBANK_TOKEN=

# Where managers get paid orders: send /id to the bot from that chat.
ADMIN_CHAT_ID=

# Where buyers collect orders from the shop, with the hours. Leave empty to
# offer Nova Poshta only.
SHOP_PICKUP_ADDRESS=

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Optional tuning. Every line below shows the default the bot uses, so an
# untouched file changes nothing. Uncomment to override.
# ---------------------------------------------------------------------------

#LLM_MODEL=claude-haiku-5-5
#LLM_EFFORT=low
#AGENT_RATE_LIMIT=30
#AGENT_RATE_WINDOW=1h
#AGENT_HISTORY_TTL=24h
#PAYMENT_RECONCILE_EVERY=30s
#CART_REMINDER_AFTER=24h
#BOT_TIMEZONE=Europe/Kyiv
